NODE_ENV=production
HOST=127.0.0.1
PORT=4173
OPENREEL_DATABASE=/var/lib/openreel/openreel.sqlite
OPENREEL_ASSETS=/var/lib/openreel/assets
OPENREEL_PLATFORM=/var/lib/openreel/platform.json
OPENREEL_FEEDBACK_STATE=/var/lib/openreel/product-feedback.json
# Atomic publishing recovery bundle: encrypted OAuth snapshot, four job stores and batch/audit store.
OPENREEL_PUBLISHING_STATE=/var/lib/openreel/publishing
# Generate a separate 32-byte key on the production host; never reuse the session secret.
OPENREEL_PUBLISHING_MASTER_KEY=
# YouTube OAuth remains unavailable unless all three values below and the publishing state/key above are present.
OPENREEL_GOOGLE_OAUTH_CLIENT_ID=
OPENREEL_GOOGLE_OAUTH_CLIENT_SECRET=
# Beijing cutover value: https://openreel.io:4173/api/v1/publishing/oauth/youtube_shorts/callback
OPENREEL_GOOGLE_OAUTH_REDIRECT_URI=
# TikTok Login Kit + Content Posting API credentials. Keep unset until the app and video.publish scope are approved.
OPENREEL_TIKTOK_CLIENT_KEY=
OPENREEL_TIKTOK_CLIENT_SECRET=
# Keep unset until YouTube terminal acceptance; later value uses the authorized public origin.
OPENREEL_TIKTOK_REDIRECT_URI=
# Optional loopback HTTP CONNECT endpoint reached through the Phoenix SSH tunnel.
OPENREEL_PUBLISHING_PROXY_URL=
OPENREEL_SESSION_SECRET=replace-with-at-least-32-random-characters
OPENREEL_ADMIN_KEY=replace-with-a-separate-32-character-admin-secret
# Browser Admin login stores only a scrypt hash. Generate it on the production host.
OPENREEL_ADMIN_PASSWORD_HASH=

# Paid Ark inference is off by default. Never commit a real key or endpoint id.
ARK_ENABLED=false
ARK_API_KEY=
ARK_ALLOWED_HOSTS=
ARK_MODELS_JSON={}

# Optional Seedance presets. Supply the endpoint IDs created in your Ark account.
OPENREEL_VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OPENREEL_VOLCENGINE_DIRECT_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
OPENREEL_VOLCENGINE_API_KEY=
# Keep false until an operator approves a bounded paid verification budget.
# Production presets use the audited 1.5x price table in src/volcengine-pricing.js.
# Paid startup fails closed if a configured model has no positive price.
OPENREEL_PAID_INFERENCE_ENABLED=false
# Maximum retries after the initial provider request. Use 0 for bounded paid smoke tests.
OPENREEL_ARK_MAX_RETRIES=2
# Text planning may exceed the legacy 30s boundary. Accepted range: 30000-120000.
OPENREEL_ARK_TEXT_SUBMIT_TIMEOUT_MS=30000
OPENREEL_VOLCENGINE_SEEDANCE2_FAST_MODEL=
OPENREEL_VOLCENGINE_SEEDANCE2_MODEL=
OPENREEL_VOLCENGINE_SEEDREAM5_LITE_MODEL=
OPENREEL_VOLCENGINE_SEEDREAM5_PRO_MODEL=
OPENREEL_VOLCENGINE_SEED21_TURBO_MODEL=
OPENREEL_VOLCENGINE_SEED21_PRO_MODEL=
OPENREEL_WORKBENCH_TEXT_MODEL=seed-2.1-pro
OPENREEL_COMMERCIAL_MAX_POLLS=120
OPENREEL_VOLCENGINE_EMBEDDING_VISION_MODEL=

# Optional Tailnet-local ModelClaw / ComfyUI video provider. This is a native
# ComfyUI workflow API, not an OpenAI-compatible endpoint. The reviewed workflow
# pins MiniMax-H3-FL2VA-Pruned-Q5_K_M.gguf plus the Turbo v4 LoRA.
OPENREEL_MODELCLAW_COMFYUI_ENABLED=false
OPENREEL_MODELCLAW_COMFYUI_BASE_URL=http://100.66.206.27:8188

# Beginner workbench step 4 stays disabled unless Ark, Qwen TTS and this reviewed
# audio ceiling are all configured. Every quote also fails closed above CNY 100.
OPENREEL_COMMERCIAL_AUDIO_MAX_CNY=0
OPENREEL_COMMERCIAL_IMAGE_MODEL=
OPENREEL_COMMERCIAL_VIDEO_MODEL=
# Required for commercial generation. Must name a reviewed, bounded Ark text route
# capable of scoring image/video message content; embedding routes are rejected.
OPENREEL_COMMERCIAL_EVALUATION_MODEL=
OPENREEL_COMMERCIAL_EVALUATION_MAX_CNY_PER_CALL=
OPENREEL_COMMERCIAL_JOBS=/var/lib/openreel/commercial-jobs.json
OPENREEL_AGENT_FILMS=/var/lib/openreel/agent-films.json
OPENREEL_CNY_PER_USD=7.2
