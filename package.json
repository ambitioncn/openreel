    "smoke:render": "node scripts/render-smoke.mjs",
    "smoke:render-negative": "node scripts/render-negative-smoke.mjs",
    "smoke:http-negative": "node scripts/http-negative-smoke.mjs",
    "smoke:cli-negative": "node scripts/cli-negative-smoke.mjs",
    "smoke:workflow": "node scripts/terminal-smoke.mjs workflow",
    "smoke:budget": "node scripts/terminal-smoke.mjs budget",
    "smoke:auth": "node scripts/terminal-smoke.mjs auth",
    "smoke:tenant": "node scripts/terminal-smoke.mjs tenant",
    "smoke:import": "node scripts/terminal-smoke.mjs import",
    "scan:dependencies": "npm audit --omit=dev --audit-level=high",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "rehearse:deployment": "node scripts/rehearse-deployment.mjs",
    "smoke:production-e2e": "node scripts/production-e2e.mjs",
